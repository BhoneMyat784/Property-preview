{
  "name": "property-portal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch server/index.ts\" \"expo start --web --port 8081\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "expo start --web --port 8081",
    "db:migrate": "tsx server/migrate.ts",
    "db:seed": "tsx server/seed.ts",
    "db:generate": "drizzle-kit generate",
    "build": "expo export --platform web && node scripts/post-export.mjs && tsc -p tsconfig.server.json",
    "start": "NODE_ENV=production node build/server/index.js",
    "preview": "PORT=3000 APP_URL=http://localhost:3000 API_URL=http://localhost:3000 INTERNAL_API_URL=http://localhost:3000 SERVE_WEB=true tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:expo": "expo install --check",
    "backup": "tsx server/backup.ts",
    "admin:grant": "tsx server/grant-admin.ts",
    "format": "prettier --write src server scripts tests *.json *.ts",
    "format:check": "prettier --check src server scripts tests *.json *.ts"
  },
  "dependencies": {
    "@expo/metro-runtime": "^57.0.16",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/noto-sans-myanmar": "^5.3.0",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "better-auth": "1.7.7",
    "better-sqlite3": "^12.4.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.3",
    "expo": "57.0.26",
    "expo-constants": "^57.0.20",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "^57.0.11",
    "expo-router": "57.0.24",
    "expo-server": "^57.0.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "multer": "^2.0.2",
    "nodemailer": "^10.0.14",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.10.1",
    "sharp": "^0.35.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.10.0",
    "@types/nodemailer": "^7.0.3",
    "@types/react": "~19.2.2",
    "@types/supertest": "^6.0.3",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.6",
    "prettier": "^3.8.1",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
